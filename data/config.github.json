{
  "ai": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0.5,
    "analysis_concurrency": 4,
    "enrichment_concurrency": 3,
    "languages": [
      "ko"
